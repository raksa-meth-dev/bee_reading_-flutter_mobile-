# ==============================================================================
# Bee Reading - Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Application Environment: development | staging | production
APP_ENV=development

# Base API endpoint
API_BASE_URL=https://api.dev.beereading.com/v1

# Network timeout in milliseconds
API_TIMEOUT_MS=15000

# Logging & Debugging
ENABLE_DEBUG_LOGS=true
